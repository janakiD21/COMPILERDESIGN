%{
#include <stdio.h>
%}

letter [a-zA-Z_]
digit  [0-9]

%%
int|char|float|double|if|else|do|while|for|return { printf("Keyword: %s\n", yytext); }

{letter}({letter}|{digit})*                       { printf("IDENTIFIER: %s\n", yytext); }

{digit}+                                          { printf("CONSTANT: %s\n", yytext); }

"+"|"-"|"*"|"/"|"="|"<"|">"                       { printf("Operator: %s\n", yytext); }

";"|","|"("|")"|"{"|"}"                           { printf("Punctuation: %s\n", yytext); }

[ \t\n]                                           ;
.                                                 ;

%%

int yywrap() {
    return 1;
}

int main() {
    yylex();
    return 0;
}


