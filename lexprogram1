%{
#include<stdio.h>
int words=0,character=0,lines=0;
%}
%%
\n {lines++;character++;}
[^\n\t ]+ {words++;character+=yyleng;}
. {character++;}
%%
int main(int argc, char *argv[])
{
   if(argc>1)
   {
      FILE *fp=fopen(argv[1],"r");
      yyin=fp;
   }
   yylex();
   printf("WORDS:%d\n",words);
   printf("CHARACTERS:%d\n",character);
   printf("LINES:%d\n",lines);
   return 0;
}
int yywrap()
{
return 1;
}
